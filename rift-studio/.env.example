# ─── RIFT Studio – konfiguracja (skopiuj do .env.local) ───

# Publiczny adres strony (linki w e-mailach, sitemap, metadane)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Baza rezerwacji ───
# Domyślnie lokalny SQLite (plik poniżej). Po ustawieniu SUPABASE_URL i SUPABASE_SERVICE_ROLE_KEY
# aplikacja przełącza się na Supabase. Wymuszenie: BOOKING_STORE=sqlite | supabase
BOOKINGS_DB_PATH=./data/bookings.db
SUPABASE_URL=
# Klucz service_role – TYLKO na serwerze, nigdy w kodzie przeglądarki ani w repozytorium
SUPABASE_SERVICE_ROLE_KEY=

# ─── E-maile (Resend) ───
# Bez klucza wiadomości trafiają do logu serwera (tryb deweloperski)
RESEND_API_KEY=
MAIL_FROM="RIFT Studio <rezerwacje@twoja-domena.pl>"
# Adres studia, na który przychodzą powiadomienia o nowych rezerwacjach
STUDIO_NOTIFY_EMAIL=

# ─── Panel administracyjny (/admin) ───
# Hasło min. 10 znaków, sekret sesji min. 32 losowe znaki (np. `openssl rand -base64 48`)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
