# ---------------------------------------------------------------------------
# REHABILITIS – zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) albo ustaw w panelu hostingu.
# Plików .env* (poza tym przykładem) NIGDY nie commituj.
# ---------------------------------------------------------------------------

# Adres strony bez końcowego "/". Wymagany w produkcji (kanoniczne adresy, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Włącz indeksowanie w wyszukiwarkach dopiero po uzupełnieniu prawdziwych danych: true
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Formularz kontaktowy (wystarczy jeden kanał; bez nich formularz uczciwie informuje, że nie jest podłączony)
# Kanał 1: e-mail przez Resend (https://resend.com) – klucz API, adres gabinetu, nadawca w zweryfikowanej domenie
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
# Kanał 2: webhook (np. Make/Zapier, system rezerwacji, własny backend) – otrzyma JSON ze zgłoszeniem
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# --- Opcjonalne -----------------------------------------------------------------
# Link do kalendarza rezerwacji online – przyciski „Umów wizytę” zaczną prowadzić do niego.
NEXT_PUBLIC_BOOKING_URL=
# Klucz Google Maps Embed API (bez niego używany jest standardowy, publiczny embed bez klucza).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
