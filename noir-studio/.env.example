# Publiczny adres strony (bez końcowego ukośnika) – używany w metadanych, sitemap i robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Indeksowanie w wyszukiwarkach – włącz dopiero po uzupełnieniu prawdziwych danych.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Adres e-mail studia pokazywany w sekcji kontaktu i w menu (opcjonalnie).
NEXT_PUBLIC_STUDIO_EMAIL=

# Formularz zapytań: zapytania są przekazywane metodą POST (JSON) na ten adres,
# np. scenariusz Make/Zapier albo własny endpoint. Bez niego formularz NIE wysyła wiadomości
# i jasno informuje o tym odwiedzającego.
INQUIRY_WEBHOOK_URL=
INQUIRY_WEBHOOK_SECRET=
