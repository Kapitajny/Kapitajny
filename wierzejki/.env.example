# ---------------------------------------------------------------------------
# Wierzejki – koncepcja redesignu (ComputerIT): zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) albo ustaw w panelu hostingu.
# Plików .env* (poza tym przykładem) NIGDY nie commituj.
# Zmienne NEXT_PUBLIC_* są wbudowywane w stronę podczas `npm run build` – po zmianie przebuduj projekt.
# ---------------------------------------------------------------------------

# Adres strony bez końcowego "/" (adresy kanoniczne, mapa strony, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tryb demonstracyjny: oznaczenie „koncepcja ComputerIT”, notatki o danych do weryfikacji, strona /o-koncepcji.
# Ustaw "false" WYŁĄCZNIE po uzyskaniu zgody firmy i potwierdzeniu wszystkich danych.
NEXT_PUBLIC_DEMO_MODE=true

# Indeksowanie w wyszukiwarkach – tylko dla wersji opublikowanej przez firmę pod jej domeną.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Formularz kontaktowy (tylko po stronie serwera) --------------------------
# Bez żadnej z poniższych konfiguracji formularz waliduje dane, ale NIE wysyła wiadomości
# i jasno informuje o tym użytkownika.

# Wariant A: e-mail przez Resend (https://resend.com). Domenę nadawcy trzeba zweryfikować w Resend.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# Wariant B: webhook (Make, Zapier, n8n, własny CRM). Otrzymuje JSON z polami formularza.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# --- Opcjonalne -----------------------------------------------------------------
# Klucz Google Maps Embed API (bez niego używany jest publiczny embed bez klucza).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
