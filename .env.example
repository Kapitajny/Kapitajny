# ---------------------------------------------------------------------------
# NOIR COFFEE – zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) albo ustaw w panelu hostingu.
# Plików .env* (poza tym przykładem) NIGDY nie commituj.
# ---------------------------------------------------------------------------

# Adres strony bez końcowego "/". Wymagany w produkcji (linki powrotne ze Stripe, metadane).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (tylko po stronie serwera) --------------------------------------
# Tryb testowy: sk_test_..., produkcja: sk_live_... (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
# Sekret podpisu webhooka: whsec_... (z `stripe listen` lokalnie albo z Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=

# --- Baza zamówień ------------------------------------------------------------
# Plik SQLite (domyślnie data/orders.sqlite). Na serwerze wskaż trwały wolumen.
ORDERS_DB_PATH=data/orders.sqlite

# --- Opcjonalne -----------------------------------------------------------------
# Klucz Google Maps Embed API (bez niego używany jest standardowy, publiczny embed bez klucza).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Link do profilu na Instagramie (bez niego w stopce widnieje „do uzupełnienia”).
NEXT_PUBLIC_INSTAGRAM_URL=
# Włącz indeksowanie w wyszukiwarkach dopiero po uzupełnieniu prawdziwych danych: true
NEXT_PUBLIC_ALLOW_INDEXING=false
# Newsletter: adres webhooka przyjmującego zapisy (np. scenariusz Make/Zapier, endpoint dostawcy).
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=

# Tylko do testów lokalnych ze stripe-mock (działa wyłącznie z kluczem sk_test_):
# STRIPE_API_BASE=http://localhost:12111
