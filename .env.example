# ---------------------------------------------------------------------------
# KAPITAJNY – zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) albo ustaw w panelu hostingu.
# Plików .env* (poza tym przykładem) NIGDY nie commituj.
# ---------------------------------------------------------------------------

# Adres sklepu bez końcowego "/". Wymagany w produkcji (linki powrotne Stripe, metadane, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Nazwa sklepu wyświetlana obok logo (domyślnie KAPITAJNY).
NEXT_PUBLIC_BRAND_NAME=
# Indeksowanie w wyszukiwarkach – włącz dopiero po uzupełnieniu prawdziwych danych: true
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Dane sprzedawcy i kontakt (regulamin, kontakt, stopka) --------------------
NEXT_PUBLIC_SELLER_NAME=
NEXT_PUBLIC_SELLER_ADDRESS=
NEXT_PUBLIC_SELLER_NIP=
NEXT_PUBLIC_RETURNS_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=

# --- Płatności Stripe (tylko po stronie serwera) --------------------------------
# Tryb testowy: sk_test_..., produkcja: sk_live_... (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=
# Sekret podpisu webhooka: whsec_... (z `stripe listen` lokalnie albo z Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=

# Zamówienia demonstracyjne (bez płatności, oznaczone DEMO, nie są realizowane).
# Domyślnie włączone poza produkcją, w produkcji wyłączone. Wartości: true / false.
DEMO_ORDERS=

# --- Baza danych ---------------------------------------------------------------
# Plik SQLite z zamówieniami, stanami i kontami (domyślnie data/shop.sqlite). Na serwerze wskaż trwały wolumen.
DATABASE_PATH=data/shop.sqlite

# --- Integracje przez webhook (np. Make/Zapier albo endpoint dostawcy) ---------
# Newsletter: bez adresu formularz NIE zapisuje e-maili i mówi o tym wprost.
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_SECRET=
# Formularz kontaktowy: bez adresu wiadomość nie jest wysyłana (komunikat dla klienta).
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
# Wysyłka e-maili (link resetu hasła). Bez adresu w produkcji reset hasła jest niedostępny,
# w trybie deweloperskim link trafia do logów serwera.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=

# Tylko do testów lokalnych ze stripe-mock (działa wyłącznie z kluczem sk_test_):
# STRIPE_API_BASE=http://localhost:12111
