# ---------------------------------------------------------------------------
# MOLO Jet Club – zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) albo ustaw w panelu hostingu. Plików .env* (poza tym) NIE commituj.
# ---------------------------------------------------------------------------

# Adres strony bez końcowego "/". Wymagany w produkcji (metadane, mapa witryny).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Panel administratora (/panel) ---------------------------------------------
# Hasło: min. 10 znaków. Sekret sesji: min. 32 losowe znaki, np. `openssl rand -base64 48`.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Baza danych ------------------------------------------------------------------
# Plik SQLite (domyślnie data/kilwater.sqlite). Na serwerze wskaż trwały wolumen.
DB_PATH=data/kilwater.sqlite
# Katalog zdjęć wgrywanych w panelu (domyślnie obok bazy: data/media).
# MEDIA_DIR=
# Ustaw "false", aby nowa baza startowała z pustą flotą (bez modeli ze zdjęć).
# SEED_FLEET=false

# --- Opcjonalne -----------------------------------------------------------------
# Formularz kontaktowy: webhook przyjmujący wiadomości (np. Make, Zapier, n8n) i opcjonalny sekret.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
# Opinie Google (Places API New): klucz API i identyfikator miejsca.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Link „Oceń nas w Google” (pusty = przycisk ukryty).
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# Klucz Google Maps Embed API (bez niego używany jest publiczny embed bez klucza).
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
# Media społecznościowe (puste = ikona ukryta).
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
# Indeksowanie w wyszukiwarkach włącz dopiero po uzupełnieniu prawdziwych danych: true
NEXT_PUBLIC_ALLOW_INDEXING=false
