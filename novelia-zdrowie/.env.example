# ---------------------------------------------------------------------------
# NOVELIA ZDROWIE – zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) albo ustaw w panelu hostingu. Plików .env* NIGDY nie commituj.
# ---------------------------------------------------------------------------

# Adres sklepu bez końcowego "/". WYMAGANY w produkcji (linki w e-mailach, powroty ze Stripe).
# NEXT_PUBLIC_SITE_URL jest wstawiany do kodu przy `npm run build` (SEO, mapa strony),
# SITE_URL jest czytany przez serwer w czasie działania. Ustaw oba na ten sam adres.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000
# Włącz indeksowanie w wyszukiwarkach dopiero po uzupełnieniu danych sprzedawcy i dokumentów: true
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Dane sprzedawcy (wyświetlane w stopce, kontakcie i dokumentach) ----------
# Puste pola są oznaczane na stronie jako „do uzupełnienia”.
NEXT_PUBLIC_SELLER_NAME=
NEXT_PUBLIC_SELLER_ADDRESS=
NEXT_PUBLIC_SELLER_NIP=
NEXT_PUBLIC_SELLER_REGON=
NEXT_PUBLIC_SELLER_EMAIL=
NEXT_PUBLIC_SELLER_PHONE=

# --- Stripe (płatności: karta, BLIK, Przelewy24 – zależnie od ustawień konta) ---
# Tryb testowy: sk_test_..., produkcja: sk_live_...
STRIPE_SECRET_KEY=
# Sekret podpisu webhooka: whsec_... (z `stripe listen` lokalnie albo z Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=

# --- Bezpieczne linki do pobierania ---------------------------------------------
# Długi, losowy sekret do podpisywania linków (min. 32 znaki), np.: openssl rand -hex 32
DOWNLOAD_SECRET=
# Ważność linku w godzinach (domyślnie 72) i limit pobrań jednego pliku w zamówieniu (domyślnie 10).
DOWNLOAD_LINK_TTL_HOURS=72
DOWNLOAD_MAX_PER_ITEM=10
# Katalog z plikami PDF (poza katalogiem public!). Domyślnie: private/ebooks
EBOOKS_DIR=private/ebooks

# --- E-maile -----------------------------------------------------------------
# Dostawca: resend | smtp. Bez konfiguracji e-maile NIE są wysyłane
# (w trybie deweloperskim trafiają do katalogu data/outbox – tylko do podglądu).
EMAIL_PROVIDER=
EMAIL_FROM="NOVELIA ZDROWIE <zamowienia@twoja-domena.pl>"
# Adres sklepu – kopie powiadomień o zamówieniach i wiadomości z formularza kontaktowego.
SHOP_NOTIFICATIONS_EMAIL=
# Resend (https://resend.com):
RESEND_API_KEY=
# SMTP (np. serwer pocztowy hostingu):
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# --- Baza zamówień ----------------------------------------------------------------
# Plik SQLite (domyślnie data/orders.sqlite). Na serwerze wskaż trwały wolumen.
ORDERS_DB_PATH=data/orders.sqlite

# Tylko do testów lokalnych ze stripe-mock (działa wyłącznie z kluczem sk_test_):
# STRIPE_API_BASE=http://localhost:12111
