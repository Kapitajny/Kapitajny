# ---------------------------------------------------------------------------
# VITALIS MED – zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) albo ustaw w panelu hostingu.
# Plików .env* (poza tym przykładem) NIGDY nie commituj.
# ---------------------------------------------------------------------------

# Adres strony (bez ukośnika na końcu) – używany w metadanych, sitemap i danych strukturalnych.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indeksowanie w Google włącz dopiero po uzupełnieniu prawdziwych danych firmy.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Formularz kontaktowy: wybierz JEDEN sposób dostarczania zapytań ---------
# Bez konfiguracji formularz NIE wysyła wiadomości i jasno informuje o tym użytkownika.

# 1) Webhook (Make, Zapier, n8n, własny system zgłoszeń) – POST z danymi w JSON.
CONTACT_WEBHOOK_URL=
# Opcjonalnie: wysyłany jako nagłówek "Authorization: Bearer <sekret>".
CONTACT_WEBHOOK_SECRET=

# 2) E-mail przez Resend (https://resend.com) – domena nadawcy musi być zweryfikowana.
RESEND_API_KEY=
# Odbiorcy (po przecinku), np. dyspozytornia@twoja-domena.pl
CONTACT_EMAIL_TO=
# Nadawca, np. "Formularz Vitalis Med <formularz@twoja-domena.pl>"
CONTACT_EMAIL_FROM=

# --- Mapa Google (opcjonalnie) ---------------------------------------------
# Klucz Maps Embed API. Bez klucza używane jest publiczne osadzenie mapy.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
