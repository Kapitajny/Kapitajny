{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": false,
			"gradients": [],
			"duotone": [],
			"palette": [
				{ "slug": "espresso", "name": "Espresso (bardzo ciemny brąz)", "color": "#211813" },
				{ "slug": "chocolate", "name": "Gorzka czekolada", "color": "#302019" },
				{ "slug": "cocoa", "name": "Ciepły brąz", "color": "#493126" },
				{ "slug": "caramel", "name": "Karmel", "color": "#A66F45" },
				{ "slug": "sand", "name": "Ciepły beż", "color": "#D7C1A2" },
				{ "slug": "cream", "name": "Krem", "color": "#F1EBDD" },
				{ "slug": "ivory", "name": "Jasne tło", "color": "#FAF7F1" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1320px"
		},
		"spacing": {
			"units": ["px", "rem", "em", "%", "vh", "vw"],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "0.5rem" },
				{ "slug": "20", "name": "S", "size": "1rem" },
				{ "slug": "30", "name": "M", "size": "clamp(1.25rem, 2vw, 1.75rem)" },
				{ "slug": "40", "name": "L", "size": "clamp(1.75rem, 3.2vw, 2.75rem)" },
				{ "slug": "50", "name": "XL", "size": "clamp(2.5rem, 5vw, 4.5rem)" },
				{ "slug": "60", "name": "2XL", "size": "clamp(3.5rem, 7.5vw, 7rem)" },
				{ "slug": "70", "name": "3XL", "size": "clamp(4.5rem, 10vw, 10rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "serif",
					"name": "Cormorant Garamond",
					"fontFamily": "\"Cormorant Garamond\", \"Cormorant\", Garamond, \"Times New Roman\", serif",
					"fontFace": [
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-latin.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "normal",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-latin-ext.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-italic-latin.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Cormorant Garamond",
							"fontStyle": "italic",
							"fontWeight": "400 600",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/cormorant-garamond-italic-latin-ext.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				},
				{
					"slug": "sans",
					"name": "Jost",
					"fontFamily": "Jost, \"Helvetica Neue\", Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Jost",
							"fontStyle": "normal",
							"fontWeight": "300 600",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/jost-latin.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Jost",
							"fontStyle": "normal",
							"fontWeight": "300 600",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/jost-latin-ext.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "x-small", "name": "XS", "size": "0.75rem", "fluid": false },
				{ "slug": "small", "name": "S", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "M", "size": "1.0625rem", "fluid": { "min": "1rem", "max": "1.0625rem" } },
				{ "slug": "large", "name": "L", "size": "1.375rem", "fluid": { "min": "1.2rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "XL", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "2XL", "size": "3.75rem", "fluid": { "min": "2.5rem", "max": "3.75rem" } },
				{ "slug": "display", "name": "Display", "size": "6.5rem", "fluid": { "min": "3.1rem", "max": "6.5rem" } }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Miękki", "shadow": "0 30px 60px -30px rgba(33, 24, 19, 0.45)" }
			]
		},
		"custom": {
			"transition": "cubic-bezier(0.22, 0.61, 0.36, 1)",
			"header-height": "88px"
		},
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--ivory)",
			"text": "var(--wp--preset--color--espresso)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "350",
			"lineHeight": "1.7"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "clamp(1.25rem, 4vw, 3.5rem)",
				"right": "clamp(1.25rem, 4vw, 3.5rem)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontWeight": "500",
					"lineHeight": "1.05",
					"letterSpacing": "-0.01em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "0.98" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "lineHeight": "1.1" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "lineHeight": "1.25" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } },
			"link": {
				"color": { "text": "currentColor" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--caramel)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--caramel)",
					"text": "var(--wp--preset--color--ivory)"
				},
				"border": { "radius": "0", "width": "1px", "style": "solid", "color": "var(--wp--preset--color--caramel)" },
				"spacing": { "padding": { "top": "1.05em", "bottom": "1.05em", "left": "2.1em", "right": "2.1em" } },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "0.8125rem",
					"fontWeight": "500",
					"letterSpacing": "0.16em",
					"textTransform": "uppercase",
					"lineHeight": "1"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--cocoa)",
						"text": "var(--wp--preset--color--ivory)"
					},
					"border": { "color": "var(--wp--preset--color--cocoa)" }
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--caramel)", "offset": "3px", "style": "solid", "width": "2px" }
				}
			},
			"caption": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--cocoa)" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontSize": "1.5rem",
					"fontWeight": "500",
					"letterSpacing": "0.18em",
					"textTransform": "uppercase",
					"lineHeight": "1"
				},
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.8125rem",
					"fontWeight": "400",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				},
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--sand)" },
				"border": { "width": "1px 0 0 0" }
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--serif)",
					"fontStyle": "italic",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.25"
				},
				"border": { "width": "0" }
			},
			"core/post-title": {
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/post-terms": {
				"typography": {
					"fontSize": "0.75rem",
					"letterSpacing": "0.2em",
					"textTransform": "uppercase",
					"fontWeight": "500"
				},
				"elements": { "link": { "typography": { "textDecoration": "none" } } }
			},
			"core/image": {
				"elements": { "caption": { "typography": { "fontSize": "var(--wp--preset--font-size--small)" } } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Nagłówek", "area": "header" },
		{ "name": "footer", "title": "Stopka", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-wide", "title": "Strona – pełna szerokość, bez tytułu", "postTypes": ["page"] }
	]
}
