# ---------------------------------------------------------------------------
# InterPodatki (projekt demonstracyjny) – zmienne środowiskowe
# Skopiuj do .env.local albo ustaw w panelu hostingu. Plików .env* NIGDY nie commituj.
# ---------------------------------------------------------------------------

# Publiczny adres serwisu bez końcowego "/" (metadane, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Indeksowanie w wyszukiwarkach – włącz dopiero dla wersji produkcyjnej z prawdziwymi danymi.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Operator płatności. Obsługiwany jest wyłącznie tryb "demo" (bez połączenia z operatorem,
# bez pobierania środków). Integracja produkcyjna – patrz README, sekcja „Płatności”.
PAYMENT_PROVIDER=demo

# Przykładowe zmienne dla przyszłej integracji (tylko po stronie serwera, nigdy NEXT_PUBLIC_):
# PAYMENT_API_KEY=
# PAYMENT_WEBHOOK_SECRET=
# Przyszła wysyłka zgłoszeń (np. dostawca e-mail lub CRM) – tylko po stronie serwera:
# INQUIRY_WEBHOOK_URL=
# CAPTCHA_SECRET_KEY=
