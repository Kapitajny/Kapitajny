# ---------------------------------------------------------------------------
# Studio tatuażu – zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) albo ustaw w panelu hostingu.
# Plików .env* (poza tym przykładem) NIGDY nie commituj.
# ---------------------------------------------------------------------------

# Adres strony bez końcowego "/". Wymagany w produkcji (metadane, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Włącz indeksowanie w wyszukiwarkach dopiero po uzupełnieniu prawdziwych danych: true
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Odbiór zgłoszeń z formularza „Book your tattoo” ----------------------------
# Bez żadnego z poniższych kanałów formularz działa, ale uczciwie informuje, że wysyłka
# nie jest aktywna, a przycisk wysłania jest zablokowany. Skonfiguruj co najmniej jeden.

# 1) E-mail przez SMTP (np. skrzynka w domenie studia, home.pl, OVH, Google Workspace).
SMTP_HOST=
SMTP_PORT=587
# true dla portu 465 (SSL); dla 587 zostaw puste (STARTTLS)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Nadawca musi być adresem, z którego serwer SMTP pozwala wysyłać, np. "Studio <formularz@twojastudio.pl>"
BOOKING_EMAIL_FROM=
# Adres(y) studia, które dostają zgłoszenia (oddziel przecinkami)
BOOKING_EMAIL_TO=

# 2) Webhook (Make, Zapier, n8n, CRM) – JSON z danymi i załącznikami (base64), podpisany HMAC.
#    Musi być https:// (http:// dozwolone tylko dla localhost).
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=

# 3) Archiwum na dysku serwera (VPS / kontener z trwałym wolumenem). Katalog POZA public/.
#    Np. data/bookings – pliki zapisywane z uprawnieniami tylko dla właściciela.
BOOKING_STORAGE_DIR=

# --- Opcjonalna ochrona antyspamowa Cloudflare Turnstile ------------------------
# Działa tylko, gdy ustawione są OBA klucze (https://dash.cloudflare.com → Turnstile).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
