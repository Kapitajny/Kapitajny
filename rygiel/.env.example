# ---------------------------------------------------------------------------
# Rygiel – zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) albo ustaw w panelu hostingu.
# Plików .env* (poza tym przykładem) NIGDY nie commituj.
# ---------------------------------------------------------------------------

# Adres serwisu bez końcowego "/" – używany w adresach kanonicznych, sitemap.xml i Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indeksowanie w wyszukiwarkach. Włącz (true) dopiero po uzupełnieniu danych firmy i dokumentów.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Publiczny adres kontaktowy pokazywany w stopce i na stronie kontaktu (opcjonalnie).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Wysyłka formularza (tylko po stronie serwera) --------------------------
# Bez poniższych zmiennych formularz działa w trybie demonstracyjnym: sprawdza dane,
# ale niczego nie wysyła i jasno to komunikuje.

# Wariant A: e-mail przez Resend (https://resend.com) – wymagane wszystkie trzy.
RESEND_API_KEY=
# Adres(y) odbiorcy, rozdzielone przecinkami.
CONTACT_TO_EMAIL=
# Nadawca w zweryfikowanej domenie, np. "Formularz Rygiel <formularz@twojadomena.pl>".
CONTACT_FROM_EMAIL=

# Wariant B: webhook (np. Make, n8n, własny endpoint) – używany, gdy Resend nie jest skonfigurowany.
CONTACT_WEBHOOK_URL=
# Sekret do podpisu HMAC-SHA256 w nagłówku X-Signature-SHA256 (zalecany).
CONTACT_WEBHOOK_SECRET=
