# Adres strony (bez ukośnika na końcu) – canonical, Open Graph, sitemap.
NEXT_PUBLIC_SITE_URL=https://eloria.pl

# Indeksowanie w wyszukiwarkach – włącz dopiero po wpisaniu prawdziwych danych kliniki.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Formularze (kontakt i zapytanie o konsultację) – webhook odbierający zgłoszenia
# (np. Make, Zapier, n8n, CRM). Bez tego adresu formularze uczciwie informują, że nic nie zostało wysłane.
FORMS_WEBHOOK_URL=
# Opcjonalny sekret wysyłany jako nagłówek Authorization: Bearer <sekret>.
FORMS_WEBHOOK_SECRET=

# Zewnętrzny system rezerwacji (Booksy, Versum, Medfile, ZnanyLekarz…) – pokazuje przycisk „Otwórz kalendarz wizyt”.
NEXT_PUBLIC_BOOKING_URL=

# Profil na Instagramie (stopka).
NEXT_PUBLIC_INSTAGRAM_URL=
