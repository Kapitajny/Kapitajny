# ---------------------------------------------------------------------------
# ComputerIT – zmienne środowiskowe
# Skopiuj do .env.local (lokalnie) albo ustaw w panelu hostingu. Plików .env* (poza tym przykładem) nie commituj.
# ---------------------------------------------------------------------------

# Adres strony bez końcowego "/" (kanoniczne linki, mapa strony, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ustaw "false" na środowisku testowym, aby wyszukiwarki nie indeksowały strony.
NEXT_PUBLIC_ALLOW_INDEXING=true

# Dane kontaktowe widoczne na stronie. Puste = „do uzupełnienia”.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# --- Formularz kontaktowy ------------------------------------------------------
# Skonfiguruj co najmniej jeden kanał. Bez tego formularz informuje, że wiadomość NIE została wysłana.

# Kanał 1: e-mail przez SMTP (skrzynka w hostingu, Google Workspace, Resend SMTP itp.)
SMTP_HOST=
SMTP_PORT=587
# true dla portu 465 (SSL). Domyślnie wykrywane z numeru portu.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Adres, na który trafiają zapytania:
CONTACT_TO_EMAIL=
# Nadawca wiadomości (domyślnie SMTP_USER). Musi być dozwolony przez serwer SMTP.
CONTACT_FROM_EMAIL=

# Kanał 2: webhook (Make, Zapier, n8n, CRM) – otrzymuje JSON z danymi formularza.
CONTACT_WEBHOOK_URL=
# Opcjonalny sekret wysyłany jako nagłówek "Authorization: Bearer ...".
CONTACT_WEBHOOK_SECRET=
