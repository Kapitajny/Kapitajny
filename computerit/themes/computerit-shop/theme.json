{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Tło", "color": "#ffffff" },
				{ "slug": "surface", "name": "Tło sekcji", "color": "#f4f5f7" },
				{ "slug": "contrast", "name": "Tekst", "color": "#14171a" },
				{ "slug": "muted", "name": "Tekst pomocniczy", "color": "#4f565e" },
				{ "slug": "border", "name": "Obramowanie", "color": "#d6dade" },
				{ "slug": "accent", "name": "Akcent", "color": "#0b57d0" },
				{ "slug": "accent-contrast", "name": "Tekst na akcencie", "color": "#ffffff" },
				{ "slug": "sale", "name": "Promocja", "color": "#b42318" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1280px"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 1rem + 1vw, 1.75rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 1.5rem + 2vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 2rem + 4vw, 5rem)" }
			]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "Systemowy",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Mały", "size": "0.9375rem", "fluid": false },
				{ "slug": "medium", "name": "Średni", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Duży", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Bardzo duży", "size": "2rem", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "name": "Nagłówek strony", "size": "2.75rem", "fluid": { "min": "2rem", "max": "3rem" } }
			]
		},
		"custom": {
			"radius": "6px"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"padding": {
				"left": "var(--wp--preset--spacing--40)",
				"right": "var(--wp--preset--spacing--40)"
			},
			"blockGap": "var(--wp--preset--spacing--30)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--contrast)" },
				"typography": { "fontWeight": "650", "lineHeight": "1.2", "letterSpacing": "-0.01em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--accent-contrast)"
				},
				"border": { "radius": "var(--wp--custom--radius)" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.25rem", "right": "1.25rem" } },
				"typography": { "fontWeight": "600", "fontSize": "var(--wp--preset--font-size--medium)" },
				":hover": { "color": { "background": "#0942a3" } },
				":focus": { "outline": { "color": "var(--wp--preset--color--contrast)", "offset": "2px", "style": "solid", "width": "2px" } }
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--medium)", "fontWeight": "500" }
			},
			"core/post-title": {
				"elements": { "link": { "color": { "text": "var(--wp--preset--color--contrast)" }, "typography": { "textDecoration": "none" } } }
			},
			"woocommerce/product-price": {
				"typography": { "fontWeight": "700" }
			},
			"woocommerce/breadcrumbs": {
				"typography": { "fontSize": "var(--wp--preset--font-size--small)" },
				"color": { "text": "var(--wp--preset--color--muted)" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Nagłówek", "area": "header" },
		{ "name": "footer", "title": "Stopka", "area": "footer" },
		{ "name": "checkout-header", "title": "Nagłówek zamówienia", "area": "header" }
	],
	"customTemplates": [
		{ "name": "page-legal", "title": "Strona regulaminowa (wąska kolumna)", "postTypes": [ "page" ] }
	]
}
