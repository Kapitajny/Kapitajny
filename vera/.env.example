# Site address (no trailing slash) – canonical URLs, Open Graph, sitemap.
NEXT_PUBLIC_SITE_URL=https://vera-studio.example

# Search engine indexing – switch on only once the real studio details are in place.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Forms (contact and consultation request) – webhook that receives submissions
# (e.g. Make, Zapier, n8n, a CRM). Without it, the forms say plainly that nothing was sent.
FORMS_WEBHOOK_URL=
# Optional secret sent as the header Authorization: Bearer <secret>.
FORMS_WEBHOOK_SECRET=

# External booking system (e.g. Booksy, Versum) – shows an "Open the booking calendar" button on /book.
NEXT_PUBLIC_BOOKING_URL=

# Instagram profile (menu, footer, contact page).
NEXT_PUBLIC_INSTAGRAM_URL=
