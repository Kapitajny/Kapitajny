# Site address (no trailing slash) – canonical URLs, Open Graph, sitemap.
NEXT_PUBLIC_SITE_URL=https://vera-studio.pl

# Search indexing – enable only once real studio details are in place.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Forms (contact and consultation request) – webhook receiving submissions
# (e.g. Make, Zapier, n8n, a CRM). Without it the forms say plainly that nothing was sent.
FORMS_WEBHOOK_URL=
# Optional secret sent as the header Authorization: Bearer <secret>.
FORMS_WEBHOOK_SECRET=

# External booking system (Booksy, Versum…) – adds an "Open the online calendar" link on /book.
NEXT_PUBLIC_BOOKING_URL=

# Instagram profile (menu, footer, contact).
NEXT_PUBLIC_INSTAGRAM_URL=
